<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Live Translate"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="История"
            android:textSize="13sp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textSize="18sp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>

    <!-- Language Selector Card with Swap Button -->
    <LinearLayout
        android:id="@+id/panelLanguages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/surface"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tvOurLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Русский"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnSwapLanguages"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_swap"
            android:tint="@color/accent"
            android:contentDescription="Поменять языки местами" />

        <TextView
            android:id="@+id/tvOpponentLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="English"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Status Banner -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/surface"
        android:padding="8dp"
        android:gravity="center"
        android:text="@string/status_idle"
        android:textColor="@color/status_green"
        android:textSize="14sp" />

    <!-- Waveform Visualizer & Subtitles Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@color/surface"
        android:padding="12dp">

        <com.livetranslate.phone.ui.WaveformVisualizerView
            android:id="@+id/waveformVisualizer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="center" />

        <ScrollView
            android:id="@+id/scrollSubtitles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>
    </FrameLayout>

    <!-- Action Buttons Panel -->
    <LinearLayout
        android:id="@+id/panelIdleButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnSoloMode"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/solo_mode_btn"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnDialogueMode"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:text="@string/dialogue_mode_btn"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent" />
    </LinearLayout>

    <!-- Stop Button (Visible during active session) -->
    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="12dp"
        android:text="@string/stop_btn"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:backgroundTint="@color/stop_red" />

</LinearLayout>
